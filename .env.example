# ---- Database ----
# Local Docker default (see docker-compose.yml)
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom?schema=public"
# Integration tests (pnpm test) use a separate database whose name must end in _test.
# docker-compose creates ecom_test automatically on first start.
DATABASE_URL_TEST="postgresql://ecom:ecom@localhost:5432/ecom_test?schema=public"

# ---- Seed (pnpm db:seed) ----
# Owner admin created by the seed. Defaults to owner@example.com / ChangeMe@123 in development.
# Required in production.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32. Also used to hash OTP codes.
AUTH_SECRET=
# Required when self-hosting behind a proxy (VPS/Docker). Not needed on Vercel.
AUTH_TRUST_HOST=true

# ---- Payments (Razorpay, test mode keys for development) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Images (Cloudinary) ----
# Leave empty in development: uploads are saved to ./uploads (UPLOAD_DIR) instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary account (default "store"). Use one per client store.
CLOUDINARY_FOLDER=
# Local upload directory when Cloudinary is not configured (must be persistent in production).
UPLOAD_DIR=

# ---- Notifications ----
RESEND_API_KEY=
# SMS adapter for OTPs: "console" prints codes to the server log (development only).
SMS_PROVIDER=console
SMS_PROVIDER_KEY=

# ---- Web push (generate with: pnpm dlx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
