# ---- Database ----
# Local Docker default (see docker-compose.yml)
DATABASE_URL="postgresql://ecom:ecom@localhost:5432/ecom?schema=public"
# Integration tests (pnpm test) use a separate database whose name must end in _test.
# docker-compose creates ecom_test automatically on first start.
DATABASE_URL_TEST="postgresql://ecom:ecom@localhost:5432/ecom_test?schema=public"
# Connections per server instance (default 10). On serverless hosts use a pooled DATABASE_URL
# (PgBouncer / Supabase / Neon pooler) and set 1-3.
DATABASE_POOL_MAX=
# Queries running longer than this are cancelled (default 15000 ms).
DATABASE_STATEMENT_TIMEOUT_MS=

# ---- Seed (pnpm db:seed) ----
# Owner admin created by the seed. Defaults to owner@example.com / ChangeMe@123 in development.
# Required in production.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32. Also used to hash OTP codes.
AUTH_SECRET=
# Required when self-hosting behind a proxy (VPS/Docker). Not needed on Vercel.
AUTH_TRUST_HOST=true
# Number of reverse proxies in front of the app that append to X-Forwarded-For (default 1).
# Used to find the real client IP for rate limits; set 2 behind a CDN + load balancer.
TRUSTED_PROXY_HOPS=

# ---- Payments (see docs/payments.md) ----
# "razorpay" for real payments, "mock" for a local test payment page (refused in production
# unless ALLOW_MOCK_PAYMENTS=true, e.g. for a staging demo).
PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=false
# Razorpay: use test-mode keys (rzp_test_...) in development. The key id is shown to browsers.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in Razorpay Dashboard → Account & Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ---- Scheduled jobs ----
# Bearer token for /api/cron/* — expire-orders and send-notifications, every 5 minutes.
# Generate: openssl rand -hex 24
CRON_SECRET=

# ---- Images (Cloudinary) ----
# Leave empty in development: uploads are saved to ./uploads (UPLOAD_DIR) instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary account (default "store"). Use one per client store.
CLOUDINARY_FOLDER=
# Local upload directory when Cloudinary is not configured (must be persistent in production).
UPLOAD_DIR=

# ---- Notifications (see docs/orders.md) ----
# Email: "resend", "console" (prints to the server log) or "none". Defaults to resend when
# RESEND_API_KEY is set, otherwise console in development and none in production.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Demo Store <orders@yourdomain.in>"
EMAIL_FROM=
# SMS for login codes and order updates (see docs/sms.md): "msg91" in production, "console"
# prints to the server log (development only).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
# MSG91 template ids (DLT-approved). Add _TA / _KN variants for Tamil / Kannada templates.
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_PLACED=
MSG91_TEMPLATE_ORDER_SHIPPED=
MSG91_TEMPLATE_ORDER_DELIVERED=
MSG91_TEMPLATE_ORDER_CANCELLED=
MSG91_TEMPLATE_ORDER_RETURNED=
MSG91_TEMPLATE_CART_REMINDER=
# Set to false to send order updates by email/WhatsApp only (OTPs still use SMS).
SMS_ORDER_UPDATES=true
# WhatsApp order updates: "none" (default) or "console".
WHATSAPP_PROVIDER=none

# ---- PWA & web push (see docs/pwa.md) ----
# Generate once per store: pnpm exec web-push generate-vapid-keys
# Never change them afterwards: existing subscriptions stop working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:owner@yourstore.in
VAPID_SUBJECT=
# The service worker runs in production builds only; set true to try it with `pnpm dev`.
NEXT_PUBLIC_ENABLE_SW=false

# ---- Error monitoring and logs (see docs/security-checklist.md) ----
# Server logs are JSON lines. Levels: debug, info, warn, error (default info; debug in development).
LOG_LEVEL=
# Sentry is optional: leave the DSNs empty to disable it. Personal data is scrubbed before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance (0-1, default 0).
SENTRY_TRACES_SAMPLE_RATE=
# Only needed to upload source maps during `pnpm build` (keep the token out of the repo).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Deployment: Docker on a VPS (docker-compose.prod.yml, see docs/deployment.md) ----
# Domain served by Caddy (HTTPS certificates are automatic) and the email Let's Encrypt writes to.
DOMAIN=
ACME_EMAIL=
# Database container credentials. Use letters and digits only (openssl rand -hex 24).
POSTGRES_USER=ecom
POSTGRES_PASSWORD=
POSTGRES_DB=ecom
# Images pulled from GitHub Container Registry. Leave empty to build them on the server.
# APP_IMAGE=ghcr.io/<owner>/<repo>:latest
# TOOLS_IMAGE=ghcr.io/<owner>/<repo>:tools-latest
# Backups: kept this many days in ./backups, and copied to S3-compatible storage when a bucket is
# set (Cloudflare R2, Backblaze B2, AWS S3...). See docs/backups.md.
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---- pnpm setup:store --yes (unattended first-run setup, optional) ----
# SETUP_STORE_NAME=  SETUP_OWNER_NAME=  SETUP_OWNER_EMAIL=  SETUP_OWNER_PASSWORD=
# SETUP_LOCALES=en,ta,kn  SETUP_DEFAULT_LOCALE=en  SETUP_CONTACT_EMAIL=  SETUP_CONTACT_PHONE=
# SETUP_STATE_CODE=KA  SETUP_LEGAL_NAME=  SETUP_GST_NUMBER=  SETUP_TAX_RATE=18
# SETUP_PRICES_INCLUDE_TAX=true  SETUP_COD=true  SETUP_SHIPPING_RATE=50  SETUP_FREE_SHIPPING_ABOVE=
